# %% Duplicados, nulos, cobertura de datas e diagnóstico de outliers
print(f"Linhas duplicadas: {df_orders_total.duplicated().sum():,}")

missing_report = (
    pd.DataFrame({
        "coluna": df_orders_total.columns,
        "qtd_nulos": df_orders_total.isna().sum().values,
        "pct_nulos": (df_orders_total.isna().mean() * 100).round(2).values,
    })
    .sort_values("pct_nulos", ascending=False)
)
print(missing_report[missing_report["qtd_nulos"] > 0])

cobertura_datas = (
    df_orders_total.groupby("store_id")["date"]
    .agg(data_inicio="min", data_fim="max", dias_com_dados="nunique")
    .assign(dias_operacao=lambda d: (d["data_fim"] - d["data_inicio"]).dt.days + 1)
    .assign(cobertura_pct=lambda d: (d["dias_com_dados"] / d["dias_operacao"] * 100).round(1))
    .sort_values("cobertura_pct")
    .reset_index()
)

outlier_report = (
    df_outliers_removidos.groupby("store_id")
    .size()
    .rename("qtd_outliers_removidos")
    .reset_index()
    .sort_values("qtd_outliers_removidos", ascending=False)
)

# %% [markdown]
# ## Resumo de negócio — Lift por evento (marca e estado, por Tier)

# %% Tabelas de lift por marca/evento e estado/evento
df_ativo = df_orders_total.replace([np.inf, -np.inf], np.nan)
df_ativo = df_ativo.fillna(df_ativo.median(numeric_only=True))

lift_brand_evento = (
    df_ativo.query("tipo_data != 'dia normal'")
    .groupby(["brand_name", "evento"])
    .agg(
        pedidos_medio=("pedidos_total", "mean"),
        baseline_media=("baseline_lift", "mean"),
        lift_medio_pct=("lift_medio_evento_pct", "mean"),
        observacoes=("pedidos_total", "count"),
    )
    .round(2)
    .reset_index()
    .sort_values(["brand_name", "lift_medio_pct"], ascending=[True, False])
)

lift_estado_evento = (
    df_ativo.query("evento != 'dia normal'")
    .groupby(["store_state", "evento"])
    .agg(
        pedidos_medio=("pedidos_total", "mean"),
        baseline_media=("baseline_lift", "mean"),
        lift_medio_pct=("lift_medio_evento_pct", "mean"),
        qtd_lojas=("store_id", "nunique"),
    )
    .round(2)
    .reset_index()
    .sort_values(["store_state", "lift_medio_pct"], ascending=[True, False])
)

# %% Função reutilizável — heatmap Estado × Evento por Tier
def plot_heatmap_estado_evento(df, tier_nome):
    df_tier = df[df["Tier"] == tier_nome]
    ordem_eventos = (
        df_tier.query("evento != 'dia normal'")
        .groupby("evento", as_index=False).agg(data_inicio=("date", "min"))
        .sort_values("data_inicio")["evento"].tolist()
    )

    pivot = df_tier.pivot_table(index="store_state", columns="evento",
                                 values="lift_medio_evento_pct", aggfunc="mean")
    ordem_eventos = [e for e in ordem_eventos if e in pivot.columns]
    pivot = pivot[ordem_eventos].loc[pivot.mean(axis=1).sort_values(ascending=False).index]

    limite = np.nanmax(np.abs(pivot.values))
    fig, ax = plt.subplots(figsize=(max(12, pivot.shape[1] * 1.5), max(8, pivot.shape[0] * 0.5)))
    ax.set_facecolor("#E6E6E6")
    sns.heatmap(pivot, mask=pivot.isna(), annot=True, fmt=".1f", cmap="RdBu", center=0,
                vmin=-limite, vmax=limite, linewidths=0.6, linecolor="white",
                cbar_kws={"label": "Lift Médio (%)", "shrink": 0.8}, annot_kws={"size": 9}, ax=ax)
    ax.set_title(f"{tier_nome} — Lift Médio (%) por Estado e Evento", fontsize=15, weight="bold", pad=18)
    ax.set_xlabel("Evento"); ax.set_ylabel("Estado")
    plt.xticks(rotation=45, ha="right"); plt.yticks(rotation=0)
    plt.tight_layout(); plt.show()

for tier in df_ativo["Tier"].dropna().unique():
    plot_heatmap_estado_evento(df_ativo, tier)

# %% [markdown]
# ## Impacto por dia da semana (share e lift), por Tier

# %% Função reutilizável — impacto por dia da semana + heatmap
ORDEM_DIAS = ["Segunda", "Terça", "Quarta", "Quinta", "Sexta", "Sábado", "Domingo"]
CMAP_AZUL = sns.blend_palette(["#86A9E4", "#0000FF", "#000859"], as_cmap=True)

def impacto_dia_semana(df):
    tab = (
        df.groupby(["brand_name", "dia_da_semana"])
        .agg(pedidos_total=("pedidos_total", "sum"),
             pedidos_medio=("pedidos_total", "mean"),
             mediana=("pedidos_total", "median"),
             qtd_registros=("pedidos_total", "count"))
        .reset_index()
    )
    total_marca = tab.groupby("brand_name")["pedidos_total"].transform("sum")
    tab["share_pct"] = (tab["pedidos_total"] / total_marca * 100).round(2)
    return tab

def plot_heatmap_dia_semana(tab, titulo):
    pivot = tab.pivot(index="brand_name", columns="dia_da_semana", values="share_pct")[ORDEM_DIAS]
    pivot = pivot.loc[pivot.mean(axis=1).sort_values(ascending=False).index]

    fig, ax = plt.subplots(figsize=(max(10, pivot.shape[1] * 1.4), max(7, pivot.shape[0] * 0.55)))
    sns.heatmap(pivot, annot=True, fmt=".1f", cmap=CMAP_AZUL, linewidths=0.6, linecolor="white",
                vmin=np.floor(pivot.min().min()), vmax=np.ceil(pivot.max().max()),
                cbar_kws={"label": "Share (%)", "shrink": 0.8},
                annot_kws={"size": 9, "weight": "bold"}, ax=ax)
    ax.set_title(titulo, fontsize=15, weight="bold", pad=18)
    ax.set_xlabel("Dia da Semana"); ax.set_ylabel("Bandeira")
    ax.tick_params(axis="x", rotation=0)
    for spine in ax.spines.values():
        spine.set_visible(False)
    plt.tight_layout(); plt.show()

for tier in df_ativo["Tier"].dropna().unique():
    tab = impacto_dia_semana(df_ativo[df_ativo["Tier"] == tier])
    plot_heatmap_dia_semana(tab, f"{tier} — Share (%) dos Pedidos por Bandeira e Dia da Semana")

# %% Lift médio por dia da semana (útil para forecast)
lift_dia_semana = (
    df_ativo.groupby(["Tier", "brand_name", "dia_da_semana"])
    .agg(lift_medio_pct=("lift_incremental_pct", "mean"))
    .round(2)
    .reset_index()
)

# %% [markdown]
# ## Clusterização de lojas
# Features: volume (mm28), maturidade, intermitência, taxa de reserva e comparecimento.
# Roda tanto no conjunto geral quanto por Tier, usando a mesma função.

# %% Função reutilizável de clusterização
FEATURES_CLUSTER = ["mm28", "idade_loja_dias", "pct_sem_operacao_28", "taxa_reserva", "taxa_comparecimento"]

def clusterizar_lojas(df, titulo, k_ideal=3):
    df_lojas = (
        df.groupby(["store_id", "store_name", "brand_name"])[FEATURES_CLUSTER]
        .mean()
        .reset_index()
        .replace([np.inf, -np.inf], np.nan)
    )
    df_lojas["pct_sem_operacao_28"] = df_lojas["pct_sem_operacao_28"].fillna(0)
    for c in FEATURES_CLUSTER:
        df_lojas[c] = df_lojas[c].fillna(df_lojas[c].median())

    X = RobustScaler().fit_transform(df_lojas[FEATURES_CLUSTER])

    K_range = range(2, 6)
    silhouettes = []
    for k in K_range:
        labels = KMeans(n_clusters=k, random_state=42, n_init=10).fit_predict(X)
        silhouettes.append(silhouette_score(X, labels))
    melhor_k = list(K_range)[int(np.argmax(silhouettes))]
    print(f"[{titulo}] Melhor K por silhouette: {melhor_k} (score={max(silhouettes):.3f}) — usando k_ideal={k_ideal}")

    km_final = KMeans(n_clusters=k_ideal, random_state=42, n_init=10)
    df_lojas["cluster"] = km_final.fit_predict(X)

    perfil = df_lojas.groupby("cluster")[FEATURES_CLUSTER].mean().round(3)
    perfil_norm = (perfil - perfil.min()) / (perfil.max() - perfil.min())

    fig, ax = plt.subplots(figsize=(10, 5))
    sns.heatmap(perfil_norm.T, annot=perfil.T, fmt=".2f", cmap="RdYlGn", linewidths=0.5,
                cbar_kws={"label": "valor normalizado (0-1 por variável)"}, ax=ax)
    ax.set_title(f"{titulo} — Perfil Médio por Cluster")
    ax.set_xlabel("Cluster"); ax.set_ylabel("Variável")
    plt.tight_layout(); plt.show()

    pca = PCA(n_components=3, random_state=42)
    coords = pca.fit_transform(X)
    var = pca.explained_variance_ratio_ * 100
    df_lojas[["pca_1", "pca_2", "pca_3"]] = coords

    cores = ["#1b9e77", "#d95f02", "#7570b3", "#e7298a", "#66a61e"]
    traces = []
    for c in sorted(df_lojas["cluster"].unique()):
        sub = df_lojas[df_lojas["cluster"] == c]
        hover = (
            sub["store_name"].astype(str) + " (" + sub["brand_name"].astype(str) + ")"
            + "<br>volume(mm28): " + sub["mm28"].round(1).astype(str)
            + "<br>maturidade: " + sub["idade_loja_dias"].round(0).astype(str) + " dias"
            + "<br>intermitência: " + sub["pct_sem_operacao_28"].round(2).astype(str)
        )
        traces.append(go.Scatter3d(
            x=sub["pca_1"], y=sub["pca_2"], z=sub["pca_3"], mode="markers",
            name=f"Cluster {c} (n={len(sub)})",
            marker=dict(size=4, color=cores[c % len(cores)], opacity=0.8,
                        line=dict(width=0.5, color="white")),
            text=hover, hoverinfo="text",
        ))

    fig3d = go.Figure(data=traces)
    fig3d.update_layout(
        title=dict(text=f"{titulo} — Clusters de Lojas (PCA 3D, {var[:3].sum():.0f}% var. explicada)", x=0.5),
        scene=dict(xaxis_title=f"PC1 ({var[0]:.0f}%)", yaxis_title=f"PC2 ({var[1]:.0f}%)",
                   zaxis_title=f"PC3 ({var[2]:.0f}%)"),
        width=950, height=720, legend=dict(itemsizing="constant"),
    )
    fig3d.write_html(f"cluster_pca_3d_{titulo.lower().replace(' ', '_')}.html",
                      include_plotlyjs="cdn", auto_play=False)
    fig3d.show()

    return df_lojas

# %% Rodando clusterização — geral e por Tier
clusters_geral = clusterizar_lojas(df_orders_total, "Geral")

for tier in df_orders_total["Tier"].dropna().unique():
    clusterizar_lojas(df_orders_total[df_orders_total["Tier"] == tier], tier)

