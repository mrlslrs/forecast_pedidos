# %% IQR classification (business day vs weekend)
def classify_iqr(
    df, value_col="order_count", day_type_col="day_type",
    group_cols=("site_id", "year"), business_day_label="Business Day", weekend_label="Weekend",
    iqr_factor=1.5,
):
    group_cols = list(group_cols)
    df = df.copy()

    def _quartiles(day_label, suffix):
        q = (
            df[df[day_type_col] == day_label]
            .groupby(group_cols)[value_col]
            .quantile([0.25, 0.50, 0.75])
            .unstack()
            .reset_index()
        )
        q.columns = group_cols + [f"Q1{suffix}", f"Q2{suffix}", f"Q3{suffix}"]
        return q

    quartiles = _quartiles(business_day_label, "DU").merge(_quartiles(weekend_label, "FDS"), on=group_cols, how="outer")
    df = df.merge(quartiles, on=group_cols, how="left")

    for suffix in ("DU", "FDS"):
        q1, q3 = f"Q1{suffix}", f"Q3{suffix}"
        df[f"IQR{suffix}"] = df[q3] - df[q1]
        df[f"LI_{suffix}"] = df[q1] - iqr_factor * df[f"IQR{suffix}"]
        df[f"LS_{suffix}"] = df[q3] + iqr_factor * df[f"IQR{suffix}"]

    row_suffix = np.where(df[day_type_col] == business_day_label, "DU", "FDS")
    li = np.where(row_suffix == "DU", df["LI_DU"], df["LI_FDS"])
    ls = np.where(row_suffix == "DU", df["LS_DU"], df["LS_FDS"])
    is_outside = (df[value_col] < li) | (df[value_col] > ls)
    df["iqr_class"] = np.where(is_outside, "Outlier", "Inlier")

    return df

