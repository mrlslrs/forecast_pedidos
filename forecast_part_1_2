def momentum_status(short_avg, long_avg, momentum):
    if long_avg == 0 and short_avg > 0:
        return "Emerging Growth"
    if long_avg == 0 and short_avg == 0:
        return "No Movement"
    if momentum > 1.05:
        return "Growth"
    if momentum < 0.95:
        return "Decline"
    return "Stable"

