# ## Site clustering
# Features: volume (mm28), maturity, inactivity, booking conversion and attendance.
# Runs on the full dataset and by segment using the same function.

# %% Reusable clustering function
CLUSTER_FEATURES = ["mm28", "site_age_days", "inactivity_rate_28", "booking_conversion_rate", "attendance_rate"]

def cluster_sites(df, title, target_k=3):
    df_sites = (
        df.groupby(["site_id", "site_name", "retail_brand"])[CLUSTER_FEATURES]
        .mean()
        .reset_index()
        .replace([np.inf, -np.inf], np.nan)
    )
    df_sites["inactivity_rate_28"] = df_sites["inactivity_rate_28"].fillna(0)
    for c in CLUSTER_FEATURES:
        df_sites[c] = df_sites[c].fillna(df_sites[c].median())

    X = RobustScaler().fit_transform(df_sites[CLUSTER_FEATURES])

    K_RANGE = range(2, 6)
    silhouette_scores = []
    for k in K_RANGE:
        labels = KMeans(n_clusters=k, random_state=42, n_init=10).fit_predict(X)
        silhouette_scores.append(silhouette_score(X, labels))
    best_k = list(K_RANGE)[int(np.argmax(silhouette_scores))]
    print(f"[{title}] Best K by silhouette: {best_k} (score={max(silhouette_scores):.3f}) — using target_k={target_k}")

    km_final = KMeans(n_clusters=target_k, random_state=42, n_init=10)
    df_sites["cluster"] = km_final.fit_predict(X)

    cluster_profile = df_sites.groupby("cluster")[CLUSTER_FEATURES].mean().round(3)
    profile_norm = (cluster_profile - cluster_profile.min()) / (cluster_profile.max() - cluster_profile.min())

    fig, ax = plt.subplots(figsize=(10, 5))
    sns.heatmap(profile_norm.T, annot=cluster_profile.T, fmt=".2f", cmap="RdYlGn", linewidths=0.5,
                cbar_kws={"label": "normalized value (0-1 per feature)"}, ax=ax)
    ax.set_title(f"{title} — Average Cluster Profile")
    ax.set_xlabel("Cluster"); ax.set_ylabel("Feature")
    plt.tight_layout(); plt.show()

    pca = PCA(n_components=3, random_state=42)
    coords = pca.fit_transform(X)
    var = pca.explained_variance_ratio_ * 100
    df_sites[["pca_1", "pca_2", "pca_3"]] = coords

    colors = ["#1b9e77", "#d95f02", "#7570b3", "#e7298a", "#66a61e"]
    traces = []
    for c in sorted(df_sites["cluster"].unique()):
        sub = df_sites[df_sites["cluster"] == c]
        hover = (
            sub["site_name"].astype(str) + " (" + sub["retail_brand"].astype(str) + ")"
            + "<br>volume(mm28): " + sub["mm28"].round(1).astype(str)
            + "<br>site age: " + sub["site_age_days"].round(0).astype(str) + " days"
            + "<br>inactivity: " + sub["inactivity_rate_28"].round(2).astype(str)
        )
        traces.append(go.Scatter3d(
            x=sub["pca_1"], y=sub["pca_2"], z=sub["pca_3"], mode="markers",
            name=f"Cluster {c} (n={len(sub)})",
            marker=dict(size=4, color=colors[c % len(colors)], opacity=0.8,
                        line=dict(width=0.5, color="white")),
            text=hover, hoverinfo="text",
        ))

    fig3d = go.Figure(data=traces)
    fig3d.update_layout(
        title=dict(text=f"{title} — Site Clusters (PCA 3D, {var[:3].sum():.0f}% explained variance)", x=0.5),
        scene=dict(xaxis_title=f"PC1 ({var[0]:.0f}%)", yaxis_title=f"PC2 ({var[1]:.0f}%)",
                   zaxis_title=f"PC3 ({var[2]:.0f}%)"),
        width=950, height=720, legend=dict(itemsizing="constant"),
    )
    fig3d.write_html(f"cluster_pca_3d_{title.lower().replace(' ', '_')}.html",
                      include_plotlyjs="cdn", auto_play=False)
    fig3d.show()

    return df_sites

# %% Run clustering — overall and by segment
overall_clusters = cluster_sites(df_order_features, "Overall")

for segment in df_order_features["Segment"].dropna().unique():
    cluster_sites(df_order_features[df_order_features["Segment"] == segment], segment)

