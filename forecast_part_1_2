# %% Lift — impact of events/campaigns on order volume
NORMAL_BASELINE_WINDOW = 28
EVENT_FALLBACK_WINDOWS = [14, 21, 28, 42, 56, 90, 180, 365]
INACTIVITY_WINDOWS = [7, 14, 21, 28]
MIN_BASELINE_DAYS = 3
REGULAR_DAY_LABEL = "regular day"

def _classify_zero_days(df_site):
    has_orders = df_site["order_count"] > 0
    has_booked_slots = df_site["booked_slots"] > 0
    zero_type = pd.Series("normal operation", index=df_site.index)
    zero_type[~has_orders & has_booked_slots] = "operational zero"
    zero_type[~has_orders & ~has_booked_slots] = "true zero"
    return zero_type

def _identify_event_blocks(df_site, event_mask):
    if not event_mask.any():
        return pd.DataFrame(columns=["start_idx", "end_idx", "event_name"])

    event_name, order_date = df_site["event_name"], df_site["order_date"]
    new_block = event_mask & (
        ~event_mask.shift(1, fill_value=False)
        | (event_name != event_name.shift(1))
        | (order_date.diff().dt.days != 1)
    )
    block_id = new_block.cumsum().where(event_mask)

    return (
        df_site.loc[event_mask]
        .assign(_block_id=block_id[event_mask])
        .groupby("_block_id")
        .apply(lambda g: pd.Series({
            "start_idx": g.index.min(), "end_idx": g.index.max(), "event_name": g["event_name"].iloc[0],
        }), include_groups=False)
        .reset_index(drop=True)
    )

def _calculate_regular_baseline(df_site, baseline_mask):
    regular_orders = df_site["baseline_input_orders"].where(baseline_mask)
    return regular_orders.shift(1).rolling(window=NORMAL_BASELINE_WINDOW, min_periods=1).mean()

def _baseline_for_event_block(df_site, baseline_mask, start_idx):
    event_start_date = df_site.loc[start_idx, "order_date"]
    before_event = baseline_mask & (df_site["order_date"] < event_start_date)

    for days in EVENT_FALLBACK_WINDOWS:
        in_window = before_event & (df_site["order_date"] >= event_start_date - pd.Timedelta(days=days))
        valid = in_window & df_site["baseline_input_orders"].notna()
        if valid.sum() >= MIN_BASELINE_DAYS:
            return df_site.loc[valid, "baseline_input_orders"].mean()

    all_valid = before_event & df_site["baseline_input_orders"].notna()
    if all_valid.sum() >= 1:
        return df_site.loc[all_valid, "baseline_input_orders"].mean()

    if start_idx > df_site.index.min():
        return df_site.loc[start_idx - 1, "baseline_orders"]
    return np.nan

def _add_inactivity_features(df_site):
    df_site["operated_today"] = (df_site["order_count"] > 0).astype(int)
    is_true_zero = (df_site["zero_type"] == "true zero").astype(float)
    for window in INACTIVITY_WINDOWS:
        df_site[f"inactivity_rate_{window}"] = (
            is_true_zero.shift(1).rolling(window=window, min_periods=1).mean().round(4)
        )
    return df_site

def process_site(df_site):
    df_site = df_site.sort_values("order_date").reset_index(drop=True)
    baseline_mask = df_site["calendar_type"] == "regular day"
    event_mask = df_site["event_name"] != REGULAR_DAY_LABEL

    df_site["zero_type"] = _classify_zero_days(df_site)
    df_site["baseline_input_orders"] = df_site["order_count"].astype(float)
    df_site.loc[df_site["zero_type"] == "operational zero", "baseline_input_orders"] = np.nan

    df_site["baseline_orders"] = _calculate_regular_baseline(df_site, baseline_mask)

    for _, block in _identify_event_blocks(df_site, event_mask).iterrows():
        start_idx, end_idx = int(block["start_idx"]), int(block["end_idx"])
        indices = df_site.index[(df_site.index >= start_idx) & (df_site.index <= end_idx)]

        baseline = _baseline_for_event_block(df_site, baseline_mask, start_idx)
        df_site.loc[indices, "baseline_orders"] = baseline

        event_mean = df_site.loc[indices, "order_count"].mean()
        avg_lift = (
            round((event_mean - baseline) / baseline * 100, 2)
            if pd.notna(baseline) and baseline != 0 else np.nan
        )
        df_site.loc[indices, "event_avg_orders"] = round(event_mean, 2)
        df_site.loc[indices, "avg_event_lift_pct"] = avg_lift

    df_site["baseline_orders"] = df_site["baseline_orders"].round(2)
    baseline_ok = df_site["baseline_orders"].notna() & (df_site["baseline_orders"] != 0)
    df_site["invalid_baseline"] = (~baseline_ok).astype(int)
    df_site["incremental_lift_pct"] = np.where(
        baseline_ok,
        (df_site["order_count"] - df_site["baseline_orders"]) / df_site["baseline_orders"] * 100,
        np.nan,
    ).round(2)

    return _add_inactivity_features(df_site).drop(columns=["baseline_input_orders"])

def calculate_lift(df):
    df = df.sort_values(["site_id", "order_date"]).reset_index(drop=True)
    return pd.concat(
        [process_site(g).assign(site_id=sid) for sid, g in df.groupby("site_id")],
        ignore_index=True,
    )

