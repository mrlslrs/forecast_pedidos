# %% Lag, rolling-average and volatility features
def add_lags(df, value_col="order_count", group_cols="site_id",
                   date_col="order_date", lags=(1, 7, 14, 21, 28)):
    df = df.sort_values([group_cols, date_col]).copy()
    for lag in lags:
        df[f"lag_{lag}"] = df.groupby(group_cols)[value_col].shift(lag)
    return df

def add_rolling_means(df, value_col="order_count", group_cols="site_id",
                            date_col="order_date", windows=(7, 14, 21, 28), shift=1, decimals=2):
    df = df.sort_values([group_cols, date_col]).copy()
    for j in windows:
        df[f"mm{j}"] = (
            df.groupby(group_cols)[value_col]
            .transform(lambda x, j=j: x.shift(shift).rolling(j).mean().round(decimals))
        )
    return df

def add_rolling_volatility(df, value_col="order_count", group_cols="site_id",
                           date_col="order_date", windows=(7, 14, 21, 28), shift=1, decimals=2):
    df = df.sort_values([group_cols, date_col]).copy()
    for j in windows:
        df[f"std{j}"] = (
            df.groupby(group_cols)[value_col]
            .transform(lambda x, j=j: x.shift(shift).rolling(j).std().round(decimals))
        )
    return df

